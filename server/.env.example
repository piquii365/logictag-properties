# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=logictag-properties

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL=3600

# ── JWT (required) ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_JWT_EXPIRES_IN=7d
REFRESH_JWT_SECRET=

# ── Google OAuth (optional) ───────────────────────────────────
# Leave blank to disable Google sign-in; the rest of the server still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── PesePay (optional) ────────────────────────────────────────
# Leave blank to disable the PesePay payment routes.
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_RESULT_URL=

# ── SMTP (optional) ───────────────────────────────────────────
# Without SMTP_HOST + SMTP_FROM, email sending is skipped (logged in dev).
# Port 465 uses implicit TLS (SMTP_SECURE=true); 587 uses STARTTLS (false).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── WebAuthn / passkeys (optional) ────────────────────────────
# rpID must be the registrable domain of the app; ORIGIN the full origin.
# Leave blank to disable passkey sign-in.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=LogicTag Properties
WEBAUTHN_ORIGIN=

# ── Client ────────────────────────────────────────────────────
# Origin used to build links inside emails (password reset, etc.).
CLIENT_ORIGIN=logictagpropertiesmobile://
